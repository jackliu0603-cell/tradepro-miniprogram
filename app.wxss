/* app.wxss — 全局样式 */
page {
  background: #f1f5f9;
  font-size: 28rpx;
  color: #1e293b;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

/* —— 通用卡片 —— */
.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.card-header {
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #e2e8f0;
  display: flex;
  align-items: center;
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
  display: flex;
  align-items: center;
}
.card-title .dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #3b82f6;
  margin-right: 12rpx;
  display: inline-block;
}
.card-body {
  padding: 24rpx 28rpx;
}

/* —— 表单 —— */
.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.form-group {
  display: flex;
  flex-direction: column;
}
.form-group.full {
  grid-column: 1 / -1;
}
.form-label {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 8rpx;
  font-weight: 500;
}
.form-input {
  border: 1rpx solid #cbd5e1;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  background: #f8fafc;
  min-height: 72rpx;
  box-sizing: border-box;
}
.form-input:focus {
  border-color: #3b82f6;
  background: #fff;
}
.form-textarea {
  border: 1rpx solid #cbd5e1;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  background: #f8fafc;
  min-height: 120rpx;
  box-sizing: border-box;
  width: 100%;
}

/* —— 按钮 —— */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  line-height: 1.5;
}
.btn-primary {
  background: #3b82f6;
  color: #fff;
}
.btn-outline {
  background: #fff;
  color: #475569;
  border: 1rpx solid #cbd5e1;
}
.btn-gold {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #fff;
}
.btn-sm {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
}
.btn-danger {
  background: #ef4444;
  color: #fff;
}

/* —— 页面头部 —— */
.page-header {
  padding: 32rpx 28rpx 16rpx;
}
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #0f172a;
}
.page-subtitle {
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 6rpx;
}

/* —— 按钮组 —— */
.btn-group {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  padding: 0 28rpx 20rpx;
}

/* —— 表格 —— */
.data-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 24rpx;
}
.data-table th {
  background: #f1f5f9;
  padding: 16rpx 12rpx;
  text-align: left;
  font-weight: 600;
  color: #475569;
  border-bottom: 2rpx solid #e2e8f0;
}
.data-table td {
  padding: 14rpx 12rpx;
  border-bottom: 1rpx solid #e2e8f0;
  color: #334155;
}
.data-table .num {
  text-align: right;
  font-variant-numeric: tabular-nums;
}

/* —— 预览纸张 —— */
.doc-paper {
  background: #fff;
  padding: 40rpx 32rpx;
  border-radius: 8rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
  margin: 24rpx;
}
.doc-company {
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
}
.doc-company-sub {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 8rpx;
  line-height: 1.6;
}
.doc-title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: right;
  color: #1e293b;
}
.doc-meta {
  font-size: 24rpx;
  color: #475569;
  text-align: right;
  margin-top: 12rpx;
  line-height: 1.8;
}
.doc-parties {
  display: flex;
  justify-content: space-between;
  margin: 32rpx 0;
  gap: 24rpx;
}
.doc-party-block .label {
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 8rpx;
}
.doc-party-block .content {
  font-size: 26rpx;
  color: #334155;
  line-height: 1.6;
}

/* —— Toast —— */
.toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0,0,0,0.8);
  color: #fff;
  padding: 24rpx 40rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  z-index: 9999;
  pointer-events: none;
}

/* —— 空提示 —— */
.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: #94a3b8;
  font-size: 26rpx;
}
