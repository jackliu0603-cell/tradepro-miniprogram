<!-- pages/salescontract/salescontract.wxml -->
<view class="page-header">
  <view class="page-title">销售合同</view>
  <view class="page-subtitle">Sales Contract</view>
</view>

<view class="btn-group">
  <button class="btn btn-outline btn-sm" bindtap="onPreview">👁️ 预览</button>
  <button class="btn btn-outline btn-sm" bindtap="onSave">💾 保存</button>
  <button class="btn btn-danger btn-sm" bindtap="onClear">🗑️ 清空</button>
</view>

<view wx:if="{{!showPreview}}">
  <view class="card">
    <view class="card-header"><view class="card-title"><view class="dot"></view>合同信息</view></view>
    <view class="card-body">
      <view class="form-grid">
        <view class="form-group">
          <text class="form-label">合同号 *</text>
          <input class="form-input" value="{{form.no}}" bindinput="onInput" data-key="no" placeholder="SC-2026-001"/>
        </view>
        <view class="form-group">
          <text class="form-label">签订日期</text>
          <picker mode="date" value="{{form.date}}" bindchange="onDateChange" data-key="date">
            <view class="form-input">{{form.date || '选择日期'}}</view>
          </picker>
        </view>
        <view class="form-group">
          <text class="form-label">签订地点</text>
          <input class="form-input" value="{{form.place}}" bindinput="onInput" data-key="place" placeholder="Shanghai, China"/>
        </view>
        <view class="form-group">
          <text class="form-label">贸易条款</text>
          <picker range="{{termsList}}" value="{{form.termsIndex}}" bindchange="onPickerChange" data-key="terms">
            <view class="form-input">{{form.terms || '选择'}}</view>
          </picker>
        </view>
        <view class="form-group">
          <text class="form-label">起运港</text>
          <input class="form-input" value="{{form.from}}" bindinput="onInput" data-key="from"/>
        </view>
        <view class="form-group">
          <text class="form-label">目的港</text>
          <input class="form-input" value="{{form.to}}" bindinput="onInput" data-key="to"/>
        </view>
        <view class="form-group">
          <text class="form-label">付款方式</text>
          <picker range="{{paymentList}}" value="{{form.paymentIndex}}" bindchange="onPickerChange" data-key="payment">
            <view class="form-input">{{form.payment || '选择'}}</view>
          </picker>
        </view>
        <view class="form-group">
          <text class="form-label">交货期</text>
          <input class="form-input" value="{{form.delivery}}" bindinput="onInput" data-key="delivery"/>
        </view>
        <view class="form-group">
          <text class="form-label">货币</text>
          <input class="form-input" value="{{form.currency}}" bindinput="onInput" data-key="currency" placeholder="USD"/>
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-header"><view class="card-title"><view class="dot"></view>买方信息</view></view>
    <view class="card-body">
      <view class="form-grid">
        <view class="form-group">
          <text class="form-label">买方名称</text>
          <input class="form-input" value="{{form.buyerName}}" bindinput="onInput" data-key="buyerName"/>
        </view>
        <view class="form-group">
          <text class="form-label">联系人</text>
          <input class="form-input" value="{{form.buyerContact}}" bindinput="onInput" data-key="buyerContact"/>
        </view>
        <view class="form-group full">
          <text class="form-label">地址</text>
          <textarea class="form-textarea" value="{{form.buyerAddr}}" bindinput="onInput" data-key="buyerAddr"/>
        </view>
        <view class="form-group">
          <text class="form-label">电话</text>
          <input class="form-input" value="{{form.buyerTel}}" bindinput="onInput" data-key="buyerTel"/>
        </view>
        <view class="form-group">
          <text class="form-label">邮箱</text>
          <input class="form-input" value="{{form.buyerEmail}}" bindinput="onInput" data-key="buyerEmail"/>
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-header">
      <view class="card-title"><view class="dot"></view>产品明细</view>
      <button class="btn btn-primary btn-sm" bindtap="addRow">+ 添加</button>
    </view>
    <view class="card-body" wx:if="{{form.items.length > 0}}">
      <view class="item-row" wx:for="{{form.items}}" wx:key="index">
        <view class="item-row-header">
          <text class="item-no">行 {{index + 1}}</text>
          <text class="item-del" bindtap="delRow" data-index="{{index}}">删除</text>
        </view>
        <view class="form-grid">
          <view class="form-group full">
            <text class="form-label">描述</text>
            <input class="form-input" value="{{item.desc}}" bindinput="onItemInput" data-index="{{index}}" data-key="desc"/>
          </view>
          <view class="form-group">
            <text class="form-label">规格</text>
            <input class="form-input" value="{{item.spec}}" bindinput="onItemInput" data-index="{{index}}" data-key="spec"/>
          </view>
          <view class="form-group">
            <text class="form-label">数量</text>
            <input class="form-input" type="digit" value="{{item.qty}}" bindinput="onItemInput" data-index="{{index}}" data-key="qty"/>
          </view>
          <view class="form-group">
            <text class="form-label">单位</text>
            <input class="form-input" value="{{item.unit}}" bindinput="onItemInput" data-index="{{index}}" data-key="unit"/>
          </view>
          <view class="form-group">
            <text class="form-label">单价</text>
            <input class="form-input" type="digit" value="{{item.price}}" bindinput="onItemInput" data-index="{{index}}" data-key="price"/>
          </view>
        </view>
      </view>
    </view>
    <view class="card-body" wx:else>
      <view class="empty-tip">暂无产品</view>
    </view>
  </view>

  <view class="card">
    <view class="card-header"><view class="card-title"><view class="dot"></view>合同条款</view></view>
    <view class="card-body">
      <view class="form-group full" wx:for="{{clauses}}" wx:key="key" style="margin-bottom:20rpx">
        <text class="form-label">{{item.label}}</text>
        <textarea class="form-textarea" value="{{form['clause_' + item.key]}}" bindinput="onClauseInput" data-key="{{item.key}}" placeholder="{{item.placeholder}}"/>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{showPreview}}">
  <view class="btn-group">
    <button class="btn btn-outline btn-sm" bindtap="onPreview">✕ 返回编辑</button>
  </view>
  <view class="doc-paper">
    <view class="doc-header">
      <view>
        <view class="doc-company">{{companyName}}</view>
        <view class="doc-company-sub">{{companyAddr}}</view>
      </view>
      <view>
        <view class="doc-title">Sales Contract</view>
        <view class="doc-meta">
          <text><text style="font-weight:600">No.:</text> {{form.no}}</text>\n
          <text><text style="font-weight:600">Date:</text> {{form.date}}</text>\n
          <text><text style="font-weight:600">Place:</text> {{form.place}}</text>
        </view>
      </view>
    </view>

    <view class="doc-parties">
      <view class="doc-party-block">
        <view class="label">Seller / 卖方</view>
        <view class="content"><text style="font-weight:600">{{companyName}}</text>\n{{companyAddr}}</view>
      </view>
      <view class="doc-party-block">
        <view class="label">Buyer / 买方</view>
        <view class="content">
          <text style="font-weight:600">{{form.buyerName}}</text>\n
          <text wx:if="{{form.buyerContact}}">Attn: {{form.buyerContact}}</text>\n
          <text>{{form.buyerAddr}}</text>\n
          <text wx:if="{{form.buyerTel}}">Tel: {{form.buyerTel}}</text>
        </view>
      </view>
    </view>

    <view class="doc-table-wrap">
      <view class="doc-table-row doc-table-header">
        <text class="col-no">No.</text>
        <text class="col-desc">Description</text>
        <text class="col-spec">Spec</text>
        <text class="col-qty">Qty</text>
        <text class="col-unit">Unit</text>
        <text class="col-price">Price</text>
        <text class="col-amt">Amount</text>
      </view>
      <view class="doc-table-row" wx:for="{{form.items}}" wx:key="index">
        <text class="col-no">{{index + 1}}</text>
        <text class="col-desc">{{item.desc}}</text>
        <text class="col-spec">{{item.spec}}</text>
        <text class="col-qty num">{{item.qty}}</text>
        <text class="col-unit">{{item.unit}}</text>
        <text class="col-price num">{{item.price}}</text>
        <text class="col-amt num">{{item._amt}}</text>
      </view>
      <view class="doc-table-row doc-table-footer">
        <text style="flex:1;text-align:right">Total ({{form.currency || 'USD'}}):</text>
        <text class="col-amt num" style="font-weight:700">{{totalAmount}}</text>
      </view>
    </view>

    <view class="doc-footer-info" wx:for="{{clauses}}" wx:key="key" wx:if="{{form['clause_' + item.key]}}">
      <view class="doc-footer-block">
        <view class="label">{{item.label}}</view>
        <view class="content">{{form['clause_' + item.key]}}</view>
      </view>
    </view>

    <view class="doc-signature">
      <view class="sig-block">
        <view class="sig-line"></view>
        <view class="sig-label">Seller Signature</view>
      </view>
      <view class="sig-block">
        <view class="sig-line"></view>
        <view class="sig-label">Buyer Signature</view>
      </view>
    </view>
  </view>
</view>
