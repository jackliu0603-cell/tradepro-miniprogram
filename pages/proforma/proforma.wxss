/* pages/proforma/proforma.wxss */

/* —— 产品明细行 —— */
.item-row {
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  background: #f8fafc;
}
.item-row-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.item-no {
  font-size: 24rpx;
  font-weight: 600;
  color: #64748b;
}
.item-del {
  font-size: 24rpx;
  color: #ef4444;
  padding: 4rpx 16rpx;
}

/* —— 预览表格 —— */
.doc-table-wrap {
  margin: 24rpx 0;
  border: 1rpx solid #cbd5e1;
  border-radius: 8rpx;
  overflow: hidden;
}
.doc-table-row {
  display: flex;
  align-items: center;
  padding: 12rpx 8rpx;
  border-bottom: 1rpx solid #e2e8f0;
  font-size: 22rpx;
}
.doc-table-row:last-child {
  border-bottom: none;
}
.doc-table-header {
  background: #f1f5f9;
  font-weight: 600;
  color: #475569;
}
.doc-table-footer {
  background: #fef9c3;
  font-weight: 600;
}
.col-no { width: 50rpx; text-align: center; }
.col-desc { flex: 2; }
.col-spec { flex: 1; }
.col-qty { width: 100rpx; text-align: right; }
.col-unit { width: 80rpx; text-align: center; }
.col-price { width: 120rpx; text-align: right; }
.col-amt { width: 140rpx; text-align: right; }
.col-total-label { font-size: 22rpx; padding-right: 16rpx; }
.num { font-variant-numeric: tabular-nums; }

/* —— 预览底部信息 —— */
.doc-footer-info {
  margin-top: 24rpx;
  padding: 16rpx;
  background: #f8fafc;
  border-radius: 8rpx;
}
.doc-footer-block .label {
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 8rpx;
  font-weight: 600;
}
.doc-footer-block .content {
  font-size: 24rpx;
  color: #334155;
  line-height: 1.8;
}

/* —— 签名区 —— */
.doc-signature {
  display: flex;
  justify-content: space-between;
  margin-top: 60rpx;
  padding: 0 20rpx;
}
.sig-block {
  text-align: center;
}
.sig-line {
  width: 200rpx;
  height: 1rpx;
  background: #334155;
  margin-bottom: 8rpx;
}
.sig-label {
  font-size: 22rpx;
  color: #64748b;
}

/* —— doc-header —— */
.doc-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
